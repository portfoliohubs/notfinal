rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email in [
          'cources01@gmail.com',
          'admin@portfoliohubs.com',
          'portfoliohubs.contact@gmail.com'
        ] ||
        (request.auth.token.email != null &&
          request.auth.token.email.matches('.*@portfoliohubs[.]com$')));
    }

    function isPublished(uid) {
      return exists(/databases/(default)/documents/published_portfolios/$(uid));
    }

    match /website-media/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isPublished(uid);
      allow write: if isOwner(uid) || isAdmin();
    }

    match /portfolio-images/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isPublished(uid);
      allow write: if isOwner(uid) || isAdmin();
    }
  }
}
