rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'cources01@gmail.com',
          'admin@portfoliohubs.com',
          'portfoliohubs.contact@gmail.com'
        ];
    }

    function isPublished(uid) {
      return firestore.exists(/databases/(default)/documents/published_portfolios/$(uid));
    }

    function validImageWrite() {
      return request.resource == null || (
        request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
      );
    }

    match /website-media/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isPublished(uid);
      allow write: if (isOwner(uid) || isAdmin()) && validImageWrite();
    }

    match /portfolio-images/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin() || isPublished(uid);
      allow write: if (isOwner(uid) || isAdmin()) && validImageWrite();
    }
  }
}
